# Allow controller-manager (running as the installing user) to gate raw HID
# access to remapped controllers without a password. Scoped to the single
# root-owned helper; the helper only ever chmods /dev/hidraw* nodes of
# allowlisted controllers.
#
# The first field is the installing user; install.sh substitutes it.
__INSTALL_USER__ ALL=(root) NOPASSWD: /usr/local/bin/controller-hidraw-gate
