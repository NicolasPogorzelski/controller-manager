#!/usr/bin/env bash
# controller-hidraw-gate — block/restore raw HID access to a SINGLE game
# controller's /dev/hidraw node, so applications that read controllers directly
# from /dev/hidraw* cannot see the physical pad while controller-manager remaps
# it to a virtual pad.
#
#   controller-hidraw-gate block|restore /dev/hidrawN
#
# Operating on a specific node (rather than a VID:PID) lets two identical
# controllers be gated independently.
#
# Safety: only /dev/hidraw* nodes are ever chmod'd, and only if the node
# belongs to a HID device of a known controller vendor — so this can't be aimed
# at unrelated HID hardware (keyboards, fingerprint readers, …). Meant to be
# invoked through a tightly-scoped NOPASSWD sudoers rule.

set -euo pipefail

# Controller vendors whose hidraw nodes we are willing to gate (hex, upper-case):
# Microsoft, Sony, Valve, Nintendo, 8BitDo, Hori.
GAMING_VENDORS=( 045E 054C 28DE 057E 2DC8 0F0D )

action="${1:-}"
node="${2:-}"

case "$action" in
  block|restore) ;;
  *) echo "usage: $(basename "$0") block|restore /dev/hidrawN" >&2; exit 2 ;;
esac

[[ "$node" =~ ^/dev/hidraw[0-9]+$ ]] || { echo "bad node '$node'" >&2; exit 2; }
# Node already gone (e.g. controller unplugged) — nothing to do.
[[ -e "$node" ]] || { echo "$node absent, nothing to do"; exit 0; }

name="$(basename "$node")"
ue="/sys/class/hidraw/$name/device/uevent"
[[ -r "$ue" ]] || { echo "cannot read $ue" >&2; exit 3; }

# HID_ID=BUS:0000VVVV:0000PPPP  ->  extract the 4-digit vendor.
vid="$(sed -n 's/^HID_ID=[0-9A-Fa-f]*:0*\([0-9A-Fa-f]\{4\}\):.*/\1/p' "$ue" | tr 'a-f' 'A-F')"
ok=0
for v in "${GAMING_VENDORS[@]}"; do [[ "$v" == "$vid" ]] && ok=1; done
[[ $ok -eq 1 ]] || { echo "vendor '$vid' of $node not a gaming vendor — refused" >&2; exit 3; }

mode=000
[[ "$action" == restore ]] && mode=666
chmod "$mode" "$node"
echo "controller-hidraw-gate: $action $node (vendor $vid) -> $mode"
exit 0
